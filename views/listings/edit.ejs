<% layout('/layout/boilerplate') -%>
<body>
    <div class="row">
        <div class="col-8 offset-2">
    <h1 class="mt-3 mb-3">Edit Listing</h1>
    <form action="/listings/<%=listing._id%>?_method=PUT" method="post" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="mb-2">
            <label for="title" class="form-label">Title</label>
            <input type="text" name="listing[title]" value="<%= listing.title  %>" class="form-control" required>
            <div class="valid-feedback">
                Title Looks Good!
            </div>
            <div class="invalid-feedback">
                Title must be required!
            </div>
        </div>
        <div class="mb-2">
            <label for="description" class="form-label">Description</label>
            <textarea name="listing[description]"  class="form-control" required><%= listing.description  %></textarea>
            <div class="valid-feedback">
                Description Looks Good!
            </div>
            <div class="invalid-feedback">
                Description must be required!
            </div>
        </div>
        <div class="mb-2">
            <img src="<%= originalImageUrl %>" alt="">
        </div>
        <div class="mb-2">
            <label for="image" class="form-label">Image</label>
            <input type="file" name="listing[image]" value="<%= listing.image  %>" class="form-control">
        </div>
        <div class="row">
            
                <div class="mb-2 col-md-6">
                    <label for="price" class="form-label">Price</label>
                    <input type="number" name="listing[price]" value="<%= listing.price  %>" class="form-control" required>
                    <div class="valid-feedback">
                        Price Looks Good!
                    </div>
                    <div class="invalid-feedback">
                        Price must be required!
                    </div>
                </div>
                <div class="mb-2 col-md-6">
                    <label for="country" class="form-label">Country</label>
                    <input type="text" name="listing[country]" value="<%= listing.country  %>" class="form-control" required>
                    <div class="valid-feedback">
                        Country Looks Good!
                    </div>
                    <div class="invalid-feedback">
                        Country must be required!
                    </div>
                </div>
            
        </div>
        <div class="mb-2">
            <label for="location" class="form-label">Location</label>
            <input type="text" name="listing[location]" value="<%= listing.location  %>" class="form-control" required>
            <div class="valid-feedback">
                Location Looks Good!
            </div>
            <div class="invalid-feedback">
                Location must be required!
            </div>
        </div>
    
        <button class="btn btn-dark edit-btn mb-3 mt-2">Edit</button>
    </form>
</div>
</div>
</body>
