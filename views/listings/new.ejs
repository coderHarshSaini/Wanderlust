<% layout('/layout/boilerplate') -%>
<body>
    <div class="row">
        <div class="col-8 offset-2">
    <h1 class="mt-3 mb-3">Create New Listing</h1>
    <form action="/listings" method="post" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="mb-2">
            <label for="title" class="form-label">Title</label>
            <input type="text" name="listing[title]" placeholder="Enter the Title" class="form-control" required>
            <div class="valid-feedback">
                Title Looks Good!
            </div>
            <div class="invalid-feedback">
                Title must be required!
            </div>
        </div>
        <div class="mb-2">
            <label for="description" class="form-label">Description</label>
            <textarea name="listing[description]" placeholder="Enter the description" class="form-control" required></textarea>
            <div class="valid-feedback">
                Description Looks Good!
            </div>
            <div class="invalid-feedback">
                Description must be required!
            </div>
        </div>
        <div class="mb-2">
            <label for="image" class="form-label">Upload Listing Image</label>
            <input type="file" name="listing[image]" class="form-control">
            <div class="valid-feedback">
                Image Looks Good!
            </div>
        </div>
        <div class="row">
            
                <div class="mb-2 col-md-6">
                    <label for="price" class="form-label">Price</label>
                    <input type="number" name="listing[price]" placeholder="Enter the Price" class="form-control" required>
                    <div class="valid-feedback">
                        Price Looks Good!
                    </div>
                    <div class="invalid-feedback">
                        Price must be required!
                    </div>
                </div>
                <div class="mb-2 col-md-6">
                    <label for="country" class="form-label">Country</label>
                    <input type="text" name="listing[country]" placeholder="Enter the Country" class="form-control" required>
                    <div class="valid-feedback">
                        Country Looks Good!
                    </div>
                    <div class="invalid-feedback">
                        Country must be required!
                    </div>
                </div>
            
        </div>
        <div class="mb-2">
            <label for="location" class="form-label">Location</label>
            <input type="text" name="listing[location]" placeholder="Enter the Location" class="form-control" required>
            <div class="valid-feedback">
                Location Looks Good!
            </div>
            <div class="invalid-feedback">
                Location must be required!
            </div>
        </div>
    
        <button class="btn btn-dark add-btn mb-3 mt-2">Add</button>
    </form>
</div>
</div>
</body>
